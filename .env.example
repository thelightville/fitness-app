# Database
DATABASE_URL="postgresql://fitness_user:fitness_password@localhost:5432/fitness_db?schema=public"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="change-this-to-a-random-secret-at-least-32-characters"

# Email (SMTP)
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_USER="noreply@example.com"
SMTP_PASSWORD="your-smtp-password"
SMTP_FROM="Fitness App <noreply@fitness.myapps.com.ng>"

# App
APP_URL="http://localhost:3000"
APP_NAME="Fitness PT Tracker"

# Cron (optional, for reminder job)
CRON_SECRET="change-this-cron-secret"
