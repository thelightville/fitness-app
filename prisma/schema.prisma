// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CLIENT
  TRAINER
  ADMIN
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  CANCELLED
  RESCHEDULED
  CHECKED_IN
  COMPLETED
  NO_SHOW
}

enum WorkoutType {
  STRENGTH
  CARDIO
  MOBILITY
  HIIT
  ENDURANCE
  REHABILITATION
  ASSESSMENT
  CUSTOM
}

enum ReminderChannel {
  EMAIL
  SMS
  WHATSAPP
}

enum ReminderStatus {
  SCHEDULED
  SENT
  FAILED
  SKIPPED
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  password      String? // hashed, nullable for future OAuth
  name          String?
  phone         String?
  role          UserRole  @default(CLIENT)
  image         String?
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  // Relations
  client   Client?
  trainer  Trainer?
  accounts Account[]
  sessions Session[]

  auditLogs        AuditLog[]
  checkIns         AppointmentCheckIn[]
  reminders        Reminder[]
  createdByWorkout WorkoutLog[] // PT who logged the workout

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model Client {
  id              String    @id @default(cuid())
  userId          String    @unique @map("user_id")
  dateOfBirth     DateTime? @map("date_of_birth")
  emergencyName   String?   @map("emergency_name")
  emergencyPhone  String?   @map("emergency_phone")
  goals           String?
  notes           String?
  active          Boolean   @default(true)
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  appointments Appointment[]
  measurements Measurement[]

  @@map("clients")
}

model Trainer {
  id         String   @id @default(cuid())
  userId     String   @unique @map("user_id")
  bio        String?
  specialties String[]
  active     Boolean  @default(true)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  user          User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  availability  TrainerAvailability[]
  appointments  Appointment[]

  @@map("trainers")
}

model GymLocation {
  id                  String   @id @default(cuid())
  name                String
  address             String?
  latitude            Float
  longitude           Float
  checkInRadiusMeters Int      @default(150) @map("check_in_radius_meters")
  active              Boolean  @default(true)
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  appointments Appointment[]

  @@map("gym_locations")
}

model TrainerAvailability {
  id        String   @id @default(cuid())
  trainerId String   @map("trainer_id")
  dayOfWeek Int      @map("day_of_week") // 0 = Sunday, 6 = Saturday
  startTime String   @map("start_time") // HH:mm
  endTime   String   @map("end_time") // HH:mm
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  trainer Trainer @relation(fields: [trainerId], references: [id], onDelete: Cascade)

  @@map("trainer_availability")
}

model Appointment {
  id                 String            @id @default(cuid())
  clientId           String            @map("client_id")
  trainerId          String            @map("trainer_id")
  gymLocationId      String            @map("gym_location_id")
  startsAt           DateTime          @map("starts_at")
  endsAt             DateTime          @map("ends_at")
  status             AppointmentStatus @default(PENDING)
  cancellationReason String?           @map("cancellation_reason")
  rescheduleReason   String?           @map("reschedule_reason")
  createdAt          DateTime          @default(now()) @map("created_at")
  updatedAt          DateTime          @updatedAt @map("updated_at")

  client      Client               @relation(fields: [clientId], references: [id], onDelete: Cascade)
  trainer     Trainer              @relation(fields: [trainerId], references: [id], onDelete: Cascade)
  gymLocation GymLocation          @relation(fields: [gymLocationId], references: [id], onDelete: Restrict)
  checkIns    AppointmentCheckIn[]
  workoutLog  WorkoutLog?
  reminders   Reminder[]
  auditLogs   AuditLog[]

  @@index([clientId, startsAt])
  @@index([trainerId, startsAt])
  @@index([status])
  @@map("appointments")
}

model AppointmentCheckIn {
  id             String   @id @default(cuid())
  appointmentId  String   @map("appointment_id")
  userId         String   @map("user_id")
  latitude       Float
  longitude      Float
  distanceMeters Float    @map("distance_meters")
  verified       Boolean  @default(false)
  checkedInAt    DateTime @default(now()) @map("checked_in_at")
  deviceInfo     String?  @map("device_info")

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("appointment_checkins")
}

model WorkoutLog {
  id             String      @id @default(cuid())
  appointmentId  String      @unique @map("appointment_id")
  loggedById     String      @map("logged_by_id")
  workoutType    WorkoutType @map("workout_type")
  durationMinutes Int        @map("duration_minutes")
  intensity      Int? // 1-10 scale
  notes          String?
  clientFeedback String?     @map("client_feedback")
  exercises      Json? // array of {name, sets, reps, weight}
  completedAt    DateTime    @default(now()) @map("completed_at")

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  loggedBy    User        @relation(fields: [loggedById], references: [id], onDelete: Cascade)

  @@map("workout_logs")
}

model Measurement {
  id        String   @id @default(cuid())
  clientId  String   @map("client_id")
  weightKg  Float?   @map("weight_kg")
  bodyFatPct Float?  @map("body_fat_pct")
  waistCm   Float?   @map("waist_cm")
  chestCm   Float?   @map("chest_cm")
  armsCm    Float?   @map("arms_cm")
  notes     String?
  measuredAt DateTime @default(now()) @map("measured_at")

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@map("measurements")
}

model Reminder {
  id            String          @id @default(cuid())
  appointmentId String          @map("appointment_id")
  channel       ReminderChannel @default(EMAIL)
  scheduledFor  DateTime        @map("scheduled_for")
  sentAt        DateTime?       @map("sent_at")
  status        ReminderStatus  @default(SCHEDULED)
  error         String?
  createdAt     DateTime        @default(now()) @map("created_at")

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String      @map("user_id")

  @@index([status, scheduledFor])
  @@map("reminders")
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?  @map("actor_id")
  entityType String   @map("entity_type") // appointment, user, etc.
  entityId   String   @map("entity_id")
  action     String // created, updated, cancelled, checked_in, etc.
  metadata   Json?
  createdAt  DateTime @default(now()) @map("created_at")

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  appointment   Appointment? @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  appointmentId String?      @map("appointment_id")

  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}
